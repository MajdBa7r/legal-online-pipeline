# Copy these into Replit Secrets (never commit real values).

# Supabase - service key is used ONLY on the backend
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=

# Model providers (see app/gateway/models.yaml)
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# Environment: development | production (decides the PII failure policy)
APP_ENV=development

# PII masking: rules only (none) or rules + a name model (camelbert-da: needs requirements-ml.txt and
# scripts/download_name_model.py). Keep "none" until Phase 3D/3E accept the model.
# If the configured model cannot load: development -> rules only + warning; production -> /api/ask returns 503.
PII_NAME_MODEL=none
# PII_NAME_MODEL_MIN_SCORE=0.0        # chosen on the DEVELOPMENT set only (Phase 3D)
# PII_NAME_MODEL_REVISION=            # commit hash printed by scripts/download_name_model.py
# HF_HUB_OFFLINE=1                    # never contact Hugging Face at startup (model must already be downloaded)
# Experimental, off until Phase 3D: extend a detected name by one family name ("عمار السرحان").
PII_FAMILY_NAME_EXPANSION=off

# Optional overrides (defaults in app/config.py)
BUDGET_S=30
RETRY_MIN_REMAINING_S=12
MATCH_COUNT=30
CANDIDATES=40
RERANK_TOP_N=20
RERANK_QUERY=legal_rewrite
PACK_MAX_CHARS=180000
EVAL_TOKEN=change-me
DEMO_CACHE=false
LOG_LEVEL=INFO
